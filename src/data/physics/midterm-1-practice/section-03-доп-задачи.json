        {
          "title": "Скорость",
          "text": "$$v = at = 3{,}21 \\cdot 3 = 9{,}63 \\text{ м/с}$$",
          "math": "$$\\boxed{a = 3{,}21 \\text{ м/с}^2, \\; v = 9{,}63 \\text{ м/с}}$$"
        }
      ],
      "formula": "a = 3{,}21 \\text{ м/с}^2"
