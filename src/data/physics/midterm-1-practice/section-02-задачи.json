        {
          "title": "Смена направления",
          "text": "$\\omega = 0$: $-t^2 - 10t + 25 = 0 \\Rightarrow t = \\frac{-10 + \\sqrt{200}}{-2} \\approx 2{,}07$ с.\n$\\varepsilon(2{,}07) = -14{,}14$ рад/с$^2$.",
          "math": "$$\\boxed{\\varepsilon(1) = -12, \\; M = I\\varepsilon = -120 \\text{ Н$\\cdot$м}}$$"
        }
      ],
      "formula": "\\varepsilon(1) = -12 \\text{ рад/с}^2"
    },
