      "hint": "$I = mR^2/2$, $\\omega = \\gamma t^3/(3I)$",
      "steps": [
        {
          "title": "Момент инерции",
          "text": "$I = mR^2/2 = 1 \\cdot 0{,}01/2 = 0{,}005$ кг·м$^2$."
        },
