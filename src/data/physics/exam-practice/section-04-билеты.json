  "questions": [
    {
      "id": "b1-1",
      "title": "Экзамен — Задача (Качение + ЗСМИ)",
      "type": "Билет · Механика",
      "formalText": "**Экзамен, задача:** Шар ($m = 1$ кг, $R = 0{,}1$ м) катится по горизонтальной плоскости ($v_0 = 5$ м/с). Въезжает на наклонную ($30°$). На какую высоту поднимется?",
      "steps": [
        {"title": "ЗСЭ с вращением", "text": "$$\\frac{mv_0^2}{2}\\left(1 + \\frac{I}{mR^2}\\right) = mgh$$\nДля шара: $I/(mR^2) = 2/5$.\n$$\\frac{7mv_0^2}{10} = mgh$$", "math": "$$\\boxed{h = \\frac{7v_0^2}{10g}}$$"},
        {"title": "Подстановка", "text": "$h = 7 \\cdot 25/(10 \\cdot 9{,}8) = 1{,}79$ м.", "math": "$$\\boxed{h \\approx 1{,}79 \\text{ м}}$$"},
        {"title": "Длина пути по наклонной", "text": "$L = h/\\sin 30° = 3{,}57$ м.", "math": "$$\\boxed{L \\approx 3{,}57 \\text{ м}}$$"}
      ]
    },
    {
      "id": "b2-1",
      "title": "Экзамен — Задача (Цикл с изопроцессами)",
      "type": "Билет · Термодинамика",
      "formalText": "**Экзамен, задача:** $\\nu = 1$ моль одноатомного газа. 1→2 изобарное ($T_1 = 300$ К → $T_2 = 600$ К). 2→3 изохорное ($T_3 = 300$ К). 3→1 изотерма. КПД?",
      "steps": [
        {"title": "Теплоты", "text": "1→2 (изобарный): $Q_{12} = \\nu C_p \\Delta T = 20{,}79 \\cdot 300 = 6237$ Дж.\n2→3 (изохорный): $Q_{23} = \\nu C_V(T_3-T_2) = 12{,}47 \\cdot (-300) = -3741$ Дж.\n3→1 (изотерма): $V_3/V_1 =$ ? Из МК: $V_2 = 2V_1$ (изобарный), $V_3 = V_2 = 2V_1$.\n$Q_{31} = \\nu RT_1\\ln(V_1/V_3) = 8{,}314 \\cdot 300 \\cdot \\ln(0{,}5) = -1729$ Дж.", "math": "$$\\boxed{Q_{12} = 6237, \\; Q_{23} = -3741, \\; Q_{31} = -1729 \\text{ Дж}}$$"},
        {"title": "КПД", "text": "$Q_{\\text{подв}} = Q_{12} = 6237$.\n$|Q_{\\text{отв}}| = 3741 + 1729 = 5470$.\n$A = 6237 - 5470 = 767$ Дж.", "math": "$$\\boxed{\\eta = 767/6237 \\approx 12{,}3\\%}$$"},
        {"title": "Сравнение с Карно", "text": "$\\eta_{\\text{Карно}} = 1 - 300/600 = 50\\%$ — реальный цикл существенно ниже.", "math": "$$\\boxed{\\eta_{\\text{Карно}} = 50\\% \\gg \\eta = 12{,}3\\%}$$"}
      ]
    },
    {
      "id": "b3-1",
      "title": "Экзамен — Задача (Релятивистский электрон)",
      "type": "Билет · СТО",
      "formalText": "**Экзамен, задача:** Электрон ускорен до $T = 1{,}5$ МэВ ($m_0 c^2 = 0{,}511$ МэВ). Скорость, полная энергия, импульс.",
      "steps": [
        {"title": "Фактор Лоренца", "text": "$\\gamma_L = 1 + T/(m_0 c^2) = 1 + 1{,}5/0{,}511 = 3{,}94$.", "math": "$$\\boxed{\\gamma_L = 3{,}94}$$"},
        {"title": "Скорость", "text": "$\\beta = \\sqrt{1-1/\\gamma_L^2} = \\sqrt{1-0{,}064} = 0{,}967$.\n$v \\approx 0{,}97c$.", "math": "$$\\boxed{v \\approx 0{,}97c}$$"},
        {"title": "Энергия и импульс", "text": "$E = 2{,}011$ МэВ.\n$pc = \\sqrt{E^2-(m_0c^2)^2} = \\sqrt{4{,}044-0{,}261} \\approx 1{,}95$ МэВ.", "math": "$$\\boxed{E \\approx 2{,}0 \\text{ МэВ}, \\; pc \\approx 1{,}95 \\text{ МэВ}}$$"}
      ]
    },
    {
      "id": "b4-1",
      "title": "Экзамен — Задача (Физический маятник + затухание)",
      "type": "Билет · Колебания",
      "formalText": "**Экзамен, задача:** Стержень ($l = 1$ м) на оси через конец. Период? Добротность при $\\beta = 0{,}05$ с$^{-1}$?",
      "steps": [
        {"title": "Момент инерции", "text": "$I = ml^2/3$, $d = l/2$.", "math": "$$\\boxed{I = ml^2/3}$$"},
        {"title": "Период", "text": "$T = 2\\pi\\sqrt{I/(mgd)} = 2\\pi\\sqrt{2l/(3g)} = 2\\pi\\sqrt{2/(3 \\cdot 9{,}8)} \\approx 1{,}64$ с.", "math": "$$\\boxed{T \\approx 1{,}64 \\text{ с}}$$"},
        {"title": "Добротность", "text": "$\\delta = \\beta T = 0{,}05 \\cdot 1{,}64 = 0{,}082$.\n$Q = \\pi/\\delta = \\pi/0{,}082 \\approx 38$.", "math": "$$\\boxed{Q \\approx 38}$$"}
      ]
    },
    {
      "id": "b5-1",
      "title": "Экзамен — Задача (Волна: энергия и интенсивность)",
      "type": "Билет · Волны",
      "formalText": "**Экзамен, задача:** Волна в среде ($\\rho = 1{,}29$ кг/м³): $\\xi = 50\\cos(1800t - 5{,}3x)$ мкм. Фазовая скорость и интенсивность?",
      "steps": [
        {"title": "Фазовая скорость", "text": "$v = \\omega/k = 1800/5{,}3 = 340$ м/с.", "math": "$$\\boxed{v = 340 \\text{ м/с}}$$"},
        {"title": "Средняя плотность энергии", "text": "$\\langle w \\rangle = \\rho\\omega^2 A^2/2 = 0{,}5 \\cdot 1{,}29 \\cdot 1800^2 \\cdot (5 \\cdot 10^{-5})^2 \\approx 5{,}2 \\cdot 10^{-3}$ Дж/м³.", "math": "$$\\boxed{\\langle w \\rangle \\approx 5{,}2 \\cdot 10^{-3} \\text{ Дж/м³}}$$"},
        {"title": "Интенсивность", "text": "$I = \\langle w \\rangle v = 5{,}2 \\cdot 10^{-3} \\cdot 340 \\approx 1{,}78$ Вт/м².", "math": "$$\\boxed{I \\approx 1{,}78 \\text{ Вт/м²}}$$"}
      ]
    },
    {
      "id": "b6-1",
      "title": "Экзамен — Задача (Столкновение + вращение)",
      "type": "Билет · Механика",
      "formalText": "**Экзамен, задача:** Пуля ($m = 10$ г, $v = 400$ м/с) горизонтально попадает в шар ($M = 2$ кг) на конце стержня ($m_s = 1$ кг, $l = 1$ м). Ось через другой конец стержня. Угловая скорость после удара?",
      "steps": [
        {"title": "ЗСМИ", "text": "$mv \\cdot l = I_{\\text{сист}}\\omega$.\n$I_{\\text{сист}} = m_s l^2/3 + Ml^2 + ml^2 = l^2(m_s/3 + M + m)$.\n$= 1 \\cdot (0{,}333 + 2 + 0{,}01) = 2{,}343$ кг·м².", "math": "$$\\boxed{I \\approx 2{,}34 \\text{ кг·м²}}$$"},
        {"title": "Угловая скорость", "text": "$\\omega = mvl/I = 0{,}01 \\cdot 400 \\cdot 1/2{,}343 = 1{,}71$ рад/с.", "math": "$$\\boxed{\\omega \\approx 1{,}71 \\text{ рад/с}}$$"},
        {"title": "Max угол отклонения", "text": "ЗСЭ: $I\\omega^2/2 = (m_s + M + m)g \\cdot d_{\\text{ц.м.}}(1-\\cos\\theta)$.\n$d_{\\text{ц.м.}} \\approx 0{,}67$ м.\n$\\theta = \\arccos(1 - I\\omega^2/(2 \\cdot 3{,}01 \\cdot 9{,}8 \\cdot 0{,}67)) \\approx 10°$.", "math": "$$\\boxed{\\theta \\approx 10°}$$"}
      ]
    }
  ]
}