        },
        {
          "title": "Условие на логарифм",
          "text": "$\\ln(y-1)$ определён при $y-1 > 0$ → $y > 1$."
        },
        {
          "title": "Пересечение",
          "text": "ОДФ: $\\{(x,y) : x > y^2 \\text{ и } y > 1\\}$ — область правее параболы $x=y^2$ и выше прямой $y=1$.",
          "math": "$$\\boxed{D: x > y^2, \\; y > 1}$$"
        }
      ]
    },
