        {
          "title": "Ответ",
          "text": "Итоговый результат:",
          "math": "$$\\boxed{6x-2y-z = 15; \\quad \\frac{x-2}{6} = \\frac{y+1}{-2} = \\frac{z+1}{-1}}$$"
        }
      ]
