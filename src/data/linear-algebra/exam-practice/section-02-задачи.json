      "id": "1",
      "title": "Собств. числа: ((5,4),(1,2))",
      "type": "Задача · Собственные числа",
      "formalText": "Найти собственные числа и собственные вектора:\n$$A=\\begin{pmatrix}5&4\\\\1&2\\end{pmatrix}$$",
      "tldr": "det(A−λE)=λ²−7λ+6=0. Виета: λ₁+λ₂=7, λ₁λ₂=6",
      "hint": "$(5-\\lambda)(2-\\lambda)-4=\\lambda^2-7\\lambda+6=(\\lambda-1)(\\lambda-6)=0$",
      "steps": [
        {
          "title": "Хар. уравнение",
          "text": "$(5-\\lambda)(2-\\lambda)-4 = \\lambda^2-7\\lambda+6 = 0$.\n\nРаскладываем: $(\\lambda-1)(\\lambda-6)=0$.",
          "math": "$$\\lambda_1=1, \\quad \\lambda_2=6$$"
        },
        {
          "title": "Собств. вектор для λ₁=1",
          "text": "$(A-E)v=0$: $\\begin{pmatrix}4&4\\\\1&1\\end{pmatrix}v=0$.\n\n$x_1+x_2=0$ → $x_2=-x_1$.\n\n$v_1 = (1,-1)^T$."
        },
        {
          "title": "Собств. вектор для λ₂=6",
          "text": "$(A-6E)v=0$: $\\begin{pmatrix}-1&4\\\\1&-4\\end{pmatrix}v=0$.\n\n$x_1=4x_2$.\n\n$v_2 = (4,1)^T$."
        },
        {
          "title": "Ответ",
          "math": "$$\\boxed{\\lambda_1=1: v_1=(1,-1)^T; \\quad \\lambda_2=6: v_2=(4,1)^T}$$"
        }
      ]
    },
