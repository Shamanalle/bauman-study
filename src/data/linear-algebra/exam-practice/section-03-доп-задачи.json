      "id": "Д1.2",
      "title": "Собств. числа: ((1,2),(2,4))",
      "type": "Задача · Собственные числа",
      "formalText": "Найти собственные числа:\n$$A=\\begin{pmatrix}1&2\\\\2&4\\end{pmatrix}$$",
      "tldr": "det A=0 → λ=0,5",
      "hint": "$\\lambda^2-5\\lambda=0$",
      "steps": [
        {
          "title": "Хар. ур.",
          "text": "$(1-\\lambda)(4-\\lambda)-4=\\lambda^2-5\\lambda=\\lambda(\\lambda-5)=0$.",
          "math": "$$\\lambda_1=0, \\; \\lambda_2=5$$"
        },
        {
          "title": "Вектора",
          "text": "$\\lambda=0$: $v_1=(2,-1)^T$. $\\lambda=5$: $v_2=(1,2)^T$."
        },
        {
          "title": "Ответ",
          "text": "$\\det A=0$ → матрица вырожденная.",
          "math": "$$\\boxed{\\lambda=0,5}$$"
        }
      ]
    },
