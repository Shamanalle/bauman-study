      "id": "Д1.1",
      "title": "Собств. числа: ((4,2),(3,3))",
      "type": "Задача · Собственные числа",
      "formalText": "Найти собственные числа и вектора:\n$$A=\\begin{pmatrix}4&2\\\\3&3\\end{pmatrix}$$",
      "tldr": "λ²−7λ+6=0 → λ=1,6",
      "hint": "$\\lambda^2-7\\lambda+6=0$",
      "steps": [
        {
          "title": "Хар. ур.",
          "math": "$$(4-\\lambda)(3-\\lambda)-6=\\lambda^2-7\\lambda+6=(\\lambda-1)(\\lambda-6)=0$$"
        },
        {
          "title": "Вектора",
          "text": "$\\lambda=1$: $v_1=(2,-3)^T$. $\\lambda=6$: $v_2=(1,1)^T$."
        },
        {
          "title": "Ответ",
          "math": "$$\\boxed{\\lambda=1,6}$$"
        }
      ]
    },
