        {
          "title": "Корни",
          "text": "$\\lambda = \\pm i$ — комплексные. Геометрически: поворот на $90°$ без вещественных инвариантных направлений."
        },
        {
          "title": "Ответ",
          "math": "$$\\boxed{\\lambda_{1,2}=\\pm i, \\text{ вещественных собств. чисел нет}}$$"
        }
      ]
    },
