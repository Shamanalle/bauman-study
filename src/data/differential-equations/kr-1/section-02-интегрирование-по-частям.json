  "questions": [
    {
      "id": "Задача 2.1",
      "title": "∫ x³e^(2x²) dx",
      "type": "Задача · 1 балл",
      "formalText": "Вычислить: $$\\int x^3 e^{2x^2}\\, dx$$",
      "keyIdea": "Сначала подстановка \\(t = x^2\\), потом по частям",
      "steps": [
        {"title": "Подстановка", "text": "\\(t = x^2\\), \\(dt = 2x\\,dx\\). Тогда \\(x^3\\,dx = \\frac{1}{2}t\\,dt\\)"},
        {"title": "По частям", "text": "$$\\frac{1}{2}\\int t \\cdot e^{2t}\\,dt$$\nПусть \\(u = t\\), \\(dv = e^{2t}dt\\). Тогда \\(du = dt\\), \\(v = \\frac{1}{2}e^{2t}\\)."},
        {"title": "Результат", "text": "$$\\frac{1}{2}\\left(\\frac{t}{2}e^{2t} - \\frac{1}{4}e^{2t}\\right) + C = \\frac{e^{2x^2}}{4}\\left(x^2 - \\frac{1}{2}\\right) + C$$"}
      ],
      "formula": "\\frac{e^{2x^2}}{4}\\left(x^2 - \\frac{1}{2}\\right) + C"
    },
    {
      "id": "Задача 2.2",
      "title": "∫ x² cos 2x dx",
      "type": "Задача · 1 балл",
      "formalText": "Вычислить: $$\\int x^2 \\cos 2x\\, dx$$",
      "keyIdea": "Дважды по частям: понижаем степень \\(x^2 → x → 1\\)",
      "steps": [
        {"title": "Первый раз", "text": "\\(u = x^2\\), \\(dv = \\cos 2x\\,dx\\) → \\(du = 2x\\,dx\\), \\(v = \\frac{\\sin 2x}{2}\\)"},
        {"title": "Второй раз", "text": "$$\\frac{x^2 \\sin 2x}{2} - \\int x \\sin 2x\\, dx$$\n\\(u = x\\), \\(dv = \\sin 2x\\,dx\\) → \\(v = -\\frac{\\cos 2x}{2}\\)"},
        {"title": "Ответ", "text": "$$\\frac{x^2 \\sin 2x}{2} + \\frac{x \\cos 2x}{2} - \\frac{\\sin 2x}{4} + C$$"}
      ],
      "formula": "\\frac{x^2 \\sin 2x}{2} + \\frac{x \\cos 2x}{2} - \\frac{\\sin 2x}{4} + C",
      "note": "Правило: степень полинома снижается при каждом применении формулы по частям."
    },
    {
      "id": "Задача 2.5",
      "title": "∫ arctg x dx",
      "type": "Задача · 1 балл",
      "formalText": "Вычислить: $$\\int \\text{arctg}\\, x\\, dx$$",
      "keyIdea": "По частям: \\(u = \\text{arctg}\\,x\\), \\(dv = dx\\)",
      "steps": [
        {"title": "По частям", "text": "\\(u = \\text{arctg}\\,x\\), \\(dv = dx\\) → \\(du = \\frac{dx}{1+x^2}\\), \\(v = x\\)"},
        {"title": "Вычисление", "text": "$$x\\,\\text{arctg}\\,x - \\int \\frac{x\\,dx}{1+x^2} = x\\,\\text{arctg}\\,x - \\frac{1}{2}\\ln(1+x^2) + C$$"}
      ],
      "formula": "x\\,\\text{arctg}\\,x - \\frac{1}{2}\\ln(1+x^2) + C"
    },
    {
      "id": "Задача 2.8",
      "title": "∫ ln x dx",
      "type": "Задача · 1 балл",
      "formalText": "Вычислить: $$\\int \\ln x\\, dx$$",
      "keyIdea": "По частям: \\(u = \\ln x\\), \\(dv = dx\\)",
      "steps": [
        {"title": "По частям", "text": "\\(u = \\ln x\\), \\(dv = dx\\) → \\(du = \\frac{dx}{x}\\), \\(v = x\\)"},
        {"title": "Результат", "text": "$$x \\ln x - \\int \\frac{x}{x}dx = x \\ln x - x + C$$"}
      ],
      "formula": "x \\ln x - x + C",
      "note": "Классический табличный интеграл. Запомнить!"
    }
  ]
}
