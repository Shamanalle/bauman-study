      "steps": [
        {
          "title": "Табличный",
          "math": "$$\\arcsin\\frac{x}{3}+C$$"
        }
      ],
      "formula": "\\arcsin\\frac{x}{3}+C"
    },
    {
      "id": "Д1.16",
      "title": "∫ x·eˣ² dx",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int xe^{x^2}\\,dx$.",
      "hint": "$d(x^2)=2x\\,dx$ → $\\frac{1}{2}\\int e^u\\,du$",
      "steps": [
        {
          "title": "Подведение",
          "math": "$$\\frac{1}{2}\\int e^{x^2}\\,d(x^2)=\\frac{e^{x^2}}{2}+C$$"
        }
