      "steps": [
        {
          "title": "Подведение",
          "math": "$$\\int\\frac{d(x^2+3x+5)}{x^2+3x+5}=\\ln|x^2+3x+5|+C$$"
        }
      ],
      "formula": "\\ln(x^2+3x+5)+C"
    },
    {
      "id": "Д2.1",
      "title": "∫ x·sin x dx",
      "type": "Задача · По частям",
      "formalText": "Вычислить $\\int x\\sin x\\,dx$.",
      "hint": "По частям: $u=x$, $dv=\\sin x\\,dx$",
      "steps": [
        {
          "title": "По частям",
          "math": "$$-x\\cos x+\\int\\cos x\\,dx=-x\\cos x+\\sin x+C$$"
        }
      ],
      "formula": "-x\\cos x+\\sin x+C"
    },
    {
      "id": "Д2.2",
      "title": "∫ x·eˣ dx",
      "type": "Задача · По частям",
      "formalText": "Вычислить $\\int xe^x\\,dx$.",
      "hint": "$u=x$, $dv=e^x dx$",
      "steps": [
        {
          "title": "По частям",
          "math": "$$xe^x-\\int e^x\\,dx=xe^x-e^x+C=(x-1)e^x+C$$"
        }
      ],
      "formula": "(x-1)e^x+C"
    },
    {
      "id": "Д2.3",
      "title": "∫ x²·sin x dx",
      "type": "Задача · По частям",
      "formalText": "Вычислить $\\int x^2\\sin x\\,dx$.",
      "hint": "Дважды по частям. $u=x^2$, $dv=\\sin x\\,dx$",
      "steps": [
        {
          "title": "1-й раз",
          "math": "$$-x^2\\cos x+2\\int x\\cos x\\,dx$$"
        },
        {
          "title": "2-й раз",
          "math": "$$=-x^2\\cos x+2(x\\sin x+\\cos x)+C=-x^2\\cos x+2x\\sin x+2\\cos x+C$$"
        }
      ],
      "formula": "(2-x^2)\\cos x+2x\\sin x+C"
    },
    {
      "id": "Д2.4",
      "title": "∫ ln²x dx",
      "type": "Задача · По частям",
      "formalText": "Вычислить $\\int\\ln^2 x\\,dx$.",
      "hint": "$u=\\ln^2 x$, $dv=dx$ → дважды",
      "steps": [
        {
          "title": "1-й раз",
          "math": "$$x\\ln^2 x-2\\int\\ln x\\,dx$$"
        },
        {
          "title": "2-й раз",
          "text": "$\\int\\ln x\\,dx=x\\ln x-x$.",
          "math": "$$=x\\ln^2 x-2x\\ln x+2x+C$$"
        }
      ],
      "formula": "x\\ln^2 x-2x\\ln x+2x+C"
    },
    {
      "id": "Д2.5",
      "title": "∫ x·arctan x dx",
      "type": "Задача · По частям",
      "formalText": "Вычислить $\\int x\\arctan x\\,dx$.",
      "hint": "$u=\\arctan x$, $dv=x\\,dx$",
      "steps": [
        {
          "title": "По частям",
          "math": "$$\\frac{x^2}{2}\\arctan x-\\frac{1}{2}\\int\\frac{x^2}{1+x^2}\\,dx=\\frac{x^2}{2}\\arctan x-\\frac{1}{2}\\int\\left(1-\\frac{1}{1+x^2}\\right)dx$$"
        },
        {
          "title": "Итого",
          "math": "$$=\\frac{x^2}{2}\\arctan x-\\frac{x}{2}+\\frac{\\arctan x}{2}+C=\\frac{x^2+1}{2}\\arctan x-\\frac{x}{2}+C$$"
        }
      ],
      "formula": "\\frac{x^2+1}{2}\\arctan x-\\frac{x}{2}+C"
    },
    {
      "id": "Д2.6",
      "title": "∫ eˣ·sin x dx",
      "type": "Задача · По частям",
      "formalText": "Вычислить $\\int e^x\\sin x\\,dx$.",
      "hint": "Дважды по частям → уравнение $I=...-I$ → $2I=...$",
      "steps": [
        {
          "title": "Цикл",
          "text": "$I=e^x\\sin x-\\int e^x\\cos x\\,dx=e^x\\sin x-e^x\\cos x-I$.",
          "math": "$$2I=e^x(\\sin x-\\cos x) \\Rightarrow I=\\frac{e^x(\\sin x-\\cos x)}{2}+C$$"
        }
      ],
      "formula": "\\frac{e^x(\\sin x-\\cos x)}{2}+C"
    },
    {
      "id": "Д2.7",
      "title": "∫ x/cos²x dx",
      "type": "Задача · По частям",
      "formalText": "Вычислить $\\int\\frac{x}{\\cos^2 x}\\,dx$.",
      "hint": "$u=x$, $dv=\\sec^2 x\\,dx$, $v=\\tan x$",
      "steps": [
        {
          "title": "По частям",
          "math": "$$x\\tan x-\\int\\tan x\\,dx=x\\tan x+\\ln|\\cos x|+C$$"
        }
      ],
      "formula": "x\\tan x+\\ln|\\cos x|+C"
    },
    {
      "id": "Д2.8",
      "title": "∫ arcsin x dx",
      "type": "Задача · По частям",
      "formalText": "Вычислить $\\int\\arcsin x\\,dx$.",
      "hint": "$u=\\arcsin x$, $dv=dx$",
      "steps": [
        {
          "title": "По частям",
          "math": "$$x\\arcsin x-\\int\\frac{x\\,dx}{\\sqrt{1-x^2}}=x\\arcsin x+\\sqrt{1-x^2}+C$$"
        }
      ],
      "formula": "x\\arcsin x+\\sqrt{1-x^2}+C"
    },
    {
      "id": "Д2.9",
      "title": "∫ x²·eˣ dx",
      "type": "Задача · По частям",
      "formalText": "Вычислить $\\int x^2 e^x\\,dx$.",
      "hint": "Дважды по частям (или таблицу)",
      "steps": [
        {
          "title": "Формула",
          "math": "$$x^2 e^x-2xe^x+2e^x+C=(x^2-2x+2)e^x+C$$"
        }
      ],
      "formula": "(x^2-2x+2)e^x+C"
    },
    {
      "id": "Д2.10",
      "title": "∫ x·ln x dx",
      "type": "Задача · По частям",
      "formalText": "Вычислить $\\int x\\ln x\\,dx$.",
      "hint": "$u=\\ln x$, $dv=x\\,dx$",
      "steps": [
        {
          "title": "По частям",
          "math": "$$\\frac{x^2}{2}\\ln x-\\int\\frac{x}{2}\\,dx=\\frac{x^2}{2}\\ln x-\\frac{x^2}{4}+C$$"
        }
      ],
      "formula": "\\frac{x^2\\ln x}{2}-\\frac{x^2}{4}+C"
    },
    {
      "id": "Д2.11",
      "title": "∫ x³·ln x dx",
      "type": "Задача · По частям",
      "formalText": "Вычислить $\\int x^3\\ln x\\,dx$.",
      "hint": "$u=\\ln x$, $dv=x^3 dx$",
      "steps": [
        {
          "title": "По частям",
          "math": "$$\\frac{x^4}{4}\\ln x-\\frac{1}{4}\\int x^3\\,dx=\\frac{x^4}{4}\\ln x-\\frac{x^4}{16}+C$$"
