      "formula": "\\arccos\\frac{1}{|x|}+C"
    },
    {
      "id": "Д1.20",
      "title": "∫ (2x+3)/(x²+3x+5) dx",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int\\frac{2x+3}{x^2+3x+5}\\,dx$.",
