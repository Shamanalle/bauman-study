  "questions": [
    {
      "id": "Д1.1",
      "title": "∫ x/(x²+1) dx",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int\\frac{x\\,dx}{x^2+1}$.",
      "hint": "$d(x^2+1)=2x\\,dx$ → $\\frac{1}{2}\\int\\frac{du}{u}$",
      "steps": [
        {
          "title": "Подведение",
          "math": "$$\\int\\frac{x\\,dx}{x^2+1}=\\frac{1}{2}\\int\\frac{d(x^2+1)}{x^2+1}=\\frac{1}{2}\\ln(x^2+1)+C$$"
        }
      ],
      "formula": "\\frac{1}{2}\\ln(x^2+1)+C"
    },
    {
      "id": "Д1.2",
      "title": "∫ cos³x·sin x dx",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int\\cos^3 x\\sin x\\,dx$.",
      "hint": "$d(\\cos x)=-\\sin x\\,dx$ → $-\\int\\cos^3 x\\,d(\\cos x)$",
      "steps": [
        {
          "title": "Подведение",
          "math": "$$-\\int\\cos^3 x\\,d(\\cos x)=-\\frac{\\cos^4 x}{4}+C$$"
        }
      ],
      "formula": "-\\frac{\\cos^4 x}{4}+C"
    },
    {
      "id": "Д1.3",
      "title": "∫ eˢⁱⁿˣ·cos x dx",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int e^{\\sin x}\\cos x\\,dx$.",
      "hint": "$d(\\sin x)=\\cos x\\,dx$ → $\\int e^u\\,du$",
      "steps": [
        {
          "title": "Подведение",
          "math": "$$\\int e^{\\sin x}\\,d(\\sin x)=e^{\\sin x}+C$$"
        }
      ],
      "formula": "e^{\\sin x}+C"
    },
    {
      "id": "Д1.4",
      "title": "∫ tg x dx",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int\\tan x\\,dx$.",
      "hint": "$\\tan x=\\frac{\\sin x}{\\cos x}$. $d(\\cos x)=-\\sin x\\,dx$",
      "steps": [
        {
          "title": "Подведение",
          "math": "$$\\int\\frac{\\sin x}{\\cos x}\\,dx=-\\int\\frac{d(\\cos x)}{\\cos x}=-\\ln|\\cos x|+C$$"
        }
      ],
      "formula": "-\\ln|\\cos x|+C"
    },
    {
      "id": "Д1.5",
      "title": "∫ dx/(x·ln x)",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int\\frac{dx}{x\\ln x}$.",
      "hint": "$d(\\ln x)=dx/x$ → $\\int\\frac{du}{u}$",
      "steps": [
        {
          "title": "Подведение",
          "math": "$$\\int\\frac{d(\\ln x)}{\\ln x}=\\ln|\\ln x|+C$$"
        }
      ],
      "formula": "\\ln|\\ln x|+C"
    },
    {
      "id": "Д1.6",
      "title": "∫ x√(1-x²) dx",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int x\\sqrt{1-x^2}\\,dx$.",
      "hint": "$d(1-x^2)=-2x\\,dx$ → $-\\frac{1}{2}\\int\\sqrt{u}\\,du$",
      "steps": [
        {
          "title": "Подведение",
          "math": "$$-\\frac{1}{2}\\int(1-x^2)^{1/2}\\,d(1-x^2)=-\\frac{1}{2}\\cdot\\frac{2}{3}(1-x^2)^{3/2}+C=-\\frac{(1-x^2)^{3/2}}{3}+C$$"
        }
      ],
      "formula": "-\\frac{(1-x^2)^{3/2}}{3}+C"
    },
    {
      "id": "Д1.7",
      "title": "∫ dx/(1+eˣ)",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int\\frac{dx}{1+e^x}$.",
      "hint": "Раздели числитель и знаменатель на $e^x$: $\\int\\frac{e^{-x}dx}{e^{-x}+1}$",
      "steps": [
        {
          "title": "Преобразование",
          "math": "$$\\int\\frac{dx}{1+e^x}=\\int\\frac{e^x+1-e^x}{1+e^x}dx=\\int dx-\\int\\frac{e^x\\,dx}{1+e^x}=x-\\ln(1+e^x)+C$$"
        }
      ],
      "formula": "x-\\ln(1+e^x)+C"
    },
    {
      "id": "Д1.8",
      "title": "∫ sin(ln x)/x dx",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int\\frac{\\sin(\\ln x)}{x}\\,dx$.",
      "hint": "$d(\\ln x)=dx/x$ → $\\int\\sin u\\,du$",
      "steps": [
        {
          "title": "Подведение",
          "math": "$$\\int\\sin(\\ln x)\\,d(\\ln x)=-\\cos(\\ln x)+C$$"
        }
      ],
      "formula": "-\\cos(\\ln x)+C"
    },
    {
      "id": "Д1.9",
      "title": "∫ arctan x/(1+x²) dx",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int\\frac{\\arctan x}{1+x^2}\\,dx$.",
      "hint": "$d(\\arctan x)=dx/(1+x^2)$ → $\\int u\\,du$",
      "steps": [
        {
          "title": "Подведение",
          "math": "$$\\int\\arctan x\\,d(\\arctan x)=\\frac{\\arctan^2 x}{2}+C$$"
        }
      ],
      "formula": "\\frac{\\arctan^2 x}{2}+C"
    },
    {
      "id": "Д1.10",
      "title": "∫ x²/(x³+1)² dx",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int\\frac{x^2\\,dx}{(x^3+1)^2}$.",
      "hint": "$d(x^3+1)=3x^2\\,dx$ → $\\frac{1}{3}\\int u^{-2}\\,du$",
      "steps": [
        {
          "title": "Подведение",
          "math": "$$\\frac{1}{3}\\int(x^3+1)^{-2}\\,d(x^3+1)=\\frac{1}{3}\\cdot\\frac{(x^3+1)^{-1}}{-1}+C=-\\frac{1}{3(x^3+1)}+C$$"
        }
      ],
      "formula": "-\\frac{1}{3(x^3+1)}+C"
    },
    {
      "id": "Д1.11",
      "title": "∫ sec²x/(1+tg x)³ dx",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int\\frac{\\sec^2 x}{(1+\\tan x)^3}\\,dx$.",
      "hint": "$d(\\tan x)=\\sec^2 x\\,dx$ → $\\int(1+u)^{-3}\\,du$",
      "steps": [
        {
          "title": "Подведение",
          "math": "$$\\int(1+\\tan x)^{-3}\\,d(\\tan x)=\\frac{(1+\\tan x)^{-2}}{-2}+C=-\\frac{1}{2(1+\\tan x)^2}+C$$"
        }
      ],
      "formula": "-\\frac{1}{2(1+\\tan x)^2}+C"
    },
    {
      "id": "Д1.12",
      "title": "∫ eˣ/(eˣ+3) dx",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int\\frac{e^x\\,dx}{e^x+3}$.",
      "hint": "$d(e^x+3)=e^x\\,dx$ → $\\int\\frac{du}{u}$",
      "steps": [
        {
          "title": "Подведение",
          "math": "$$\\int\\frac{d(e^x+3)}{e^x+3}=\\ln(e^x+3)+C$$"
        }
      ],
      "formula": "\\ln(e^x+3)+C"
    },
    {
      "id": "Д1.13",
      "title": "∫ cos x/√(1+sin x) dx",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int\\frac{\\cos x}{\\sqrt{1+\\sin x}}\\,dx$.",
      "hint": "$d(1+\\sin x)=\\cos x\\,dx$ → $\\int u^{-1/2}\\,du$",
      "steps": [
        {
          "title": "Подведение",
          "math": "$$\\int(1+\\sin x)^{-1/2}\\,d(1+\\sin x)=2\\sqrt{1+\\sin x}+C$$"
        }
      ],
      "formula": "2\\sqrt{1+\\sin x}+C"
    },
    {
      "id": "Д1.14",
      "title": "∫ dx/(x²+4)",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int\\frac{dx}{x^2+4}$.",
      "hint": "Табличный: $\\int\\frac{dx}{x^2+a^2}=\\frac{1}{a}\\arctan\\frac{x}{a}$",
      "steps": [
        {
          "title": "Табличный",
          "math": "$$\\frac{1}{2}\\arctan\\frac{x}{2}+C$$"
        }
      ],
      "formula": "\\frac{1}{2}\\arctan\\frac{x}{2}+C"
    },
    {
      "id": "Д1.15",
      "title": "∫ dx/√(9-x²)",
