      "formula": "\\frac{e^{x^2}}{2}+C"
    },
    {
      "id": "Д1.17",
      "title": "∫ sin 3x·cos 5x dx",
      "type": "Задача · Подведение п.з.д.",
      "formalText": "Вычислить $\\int\\sin 3x\\cos 5x\\,dx$.",
      "hint": "Формула произведения: $\\sin\\alpha\\cos\\beta=\\frac{1}{2}[\\sin(\\alpha+\\beta)+\\sin(\\alpha-\\beta)]$",
      "steps": [
        {
          "title": "Формула",
          "math": "$$\\frac{1}{2}\\int[\\sin 8x+\\sin(-2x)]\\,dx=\\frac{1}{2}\\left(-\\frac{\\cos 8x}{8}+\\frac{\\cos 2x}{2}\\right)+C$$"
        }
      ],
      "formula": "-\\frac{\\cos 8x}{16}+\\frac{\\cos 2x}{4}+C"
    },
    {
      "id": "Д1.18",
      "title": "∫ sh x·ch x dx",
