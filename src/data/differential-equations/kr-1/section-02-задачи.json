        {
          "title": "Интегрирование",
          "text": "По формуле степенной функции при $n = 1/3$:",
          "math": "$$\\frac{1}{3} \\cdot \\frac{t^{4/3}}{4/3} = \\frac{1}{3} \\cdot \\frac{3}{4}\\,t^{4/3} = \\frac{t^{4/3}}{4}$$"
        },
        {
          "title": "Ответ",
          "text": "Обратная замена $t = 2+x^3$:",
          "math": "$$\\boxed{\\frac{1}{4}(2 + x^3)^{4/3} + C}$$"
        }
      ],
      "formula": "\\frac{1}{4}(2 + x^3)^{4/3} + C",
      "hint": "Подведение: $t = 2 + x^3$"
