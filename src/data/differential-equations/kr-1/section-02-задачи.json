      "steps": [
        {"title": "Анализ", "text": "Аргумент косинуса: $\\sqrt{x-1}$. Дифференцируем: $d(\\sqrt{x-1}) = \\frac{dx}{2\\sqrt{x-1}}$, значит $\\frac{dx}{\\sqrt{x-1}} = 2\\,d(\\sqrt{x-1})$."},
        {"title": "Замена", "text": "$t = \\sqrt{x-1}$, $dt = \\frac{dx}{2\\sqrt{x-1}}$, т.е. $\\frac{dx}{\\sqrt{x-1}} = 2\\,dt$:", "math": "$$\\int \\cos t \\cdot 2\\,dt = 2\\sin t + C$$"},
