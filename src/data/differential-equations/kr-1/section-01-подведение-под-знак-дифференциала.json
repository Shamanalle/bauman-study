    {
      "id": "Задача 1.1",
      "title": "Интеграл с корнем и логарифмом",
      "type": "Задача · 1 балл",
      "tldr": "Подведение \\(\\frac{1}{x}dx = d(\\ln x)\\)",
      "formalText": "Вычислить: $$\\int \\frac{\\sqrt[4]{5 + \\ln x}}{x}\\, dx$$",
      "keyIdea": "Замена: \\(t = 5 + \\ln x\\), тогда \\(dt = \\frac{dx}{x}\\)",
      "steps": [
        {"title": "Подстановка", "text": "Заметим, что \\(\\frac{dx}{x} = d(\\ln x)\\). Обозначим \\(t = 5 + \\ln x\\), тогда \\(dt = \\frac{dx}{x}\\)."},
        {"title": "Вычисление", "text": "$$\\int t^{1/4}\\, dt = \\frac{t^{5/4}}{5/4} + C = \\frac{4}{5}(5 + \\ln x)^{5/4} + C$$"}
      ],
      "formula": "\\frac{4}{5}(5 + \\ln x)^{5/4} + C",
      "note": "Ключевой приём: заметить, что знаменатель — это производная аргумента числителя."
    },
    {
      "id": "Задача 1.2",
      "title": "Интеграл с кубическим корнем",
      "type": "Задача · 1 балл",
      "formalText": "Вычислить: $$\\int x^2 \\sqrt[3]{2 + x^3}\\, dx$$",
      "keyIdea": "Замена: \\(t = 2 + x^3\\), тогда \\(dt = 3x^2 dx\\)",
      "steps": [
        {"title": "Подстановка", "text": "\\(t = 2 + x^3\\), \\(dt = 3x^2\\,dx\\), т.е. \\(x^2\\,dx = \\frac{1}{3}dt\\)"},
        {"title": "Вычисление", "text": "$$\\frac{1}{3}\\int t^{1/3}\\, dt = \\frac{1}{3} \\cdot \\frac{t^{4/3}}{4/3} + C = \\frac{1}{4}(2 + x^3)^{4/3} + C$$"}
      ],
      "formula": "\\frac{1}{4}(2 + x^3)^{4/3} + C"
    },
    {
      "id": "Задача 1.3",
      "title": "Интеграл с шестой степенью",
      "type": "Задача · 1 балл",
      "formalText": "Вычислить: $$\\int \\frac{x^2\\, dx}{x^6 - 1}$$",
      "keyIdea": "Замена \\(t = x^3\\), затем разложение на дроби или формула \\(\\frac{1}{t^2 - 1}\\)",
      "steps": [
        {"title": "Подстановка", "text": "\\(t = x^3\\), \\(dt = 3x^2\\,dx\\), т.е. \\(x^2\\,dx = \\frac{1}{3}dt\\)"},
        {"title": "Приведение", "text": "$$\\frac{1}{3}\\int \\frac{dt}{t^2 - 1} = \\frac{1}{3} \\cdot \\frac{1}{2}\\ln\\left|\\frac{t-1}{t+1}\\right| + C$$"},
        {"title": "Ответ", "text": "$$\\frac{1}{6}\\ln\\left|\\frac{x^3 - 1}{x^3 + 1}\\right| + C$$"}
      ],
      "formula": "\\frac{1}{6}\\ln\\left|\\frac{x^3 - 1}{x^3 + 1}\\right| + C"
    },
    {
      "id": "Задача 1.4",
      "title": "Тригонометрический интеграл с корнем",
      "type": "Задача · 1 балл",
      "formalText": "Вычислить: $$\\int \\frac{\\sin x\\, dx}{\\sqrt[4]{3 - \\cos x}}$$",
      "keyIdea": "\\(\\sin x\\, dx = d(-\\cos x) = d(3 - \\cos x)\\)",
      "steps": [
        {"title": "Подстановка", "text": "\\(t = 3 - \\cos x\\), \\(dt = \\sin x\\,dx\\)"},
        {"title": "Вычисление", "text": "$$\\int t^{-1/4}\\, dt = \\frac{t^{3/4}}{3/4} + C = \\frac{4}{3}(3 - \\cos x)^{3/4} + C$$"}
      ],
      "formula": "\\frac{4}{3}(3 - \\cos x)^{3/4} + C"
    },
    {
      "id": "Задача 1.5",
      "title": "Экспоненциальный интеграл с корнем",
      "type": "Задача · 1 балл",
      "formalText": "Вычислить: $$\\int e^x \\sqrt{2 - 3e^x}\\, dx$$",
      "keyIdea": "\\(t = 2 - 3e^x\\), \\(dt = -3e^x dx\\)",
      "steps": [
        {"title": "Подстановка", "text": "\\(t = 2 - 3e^x\\), \\(dt = -3e^x\\,dx\\), значит \\(e^x\\,dx = -\\frac{1}{3}dt\\)"},
        {"title": "Вычисление", "text": "$$-\\frac{1}{3}\\int t^{1/2}\\, dt = -\\frac{1}{3} \\cdot \\frac{2}{3}t^{3/2} + C = -\\frac{2}{9}(2 - 3e^x)^{3/2} + C$$"}
      ],
      "formula": "-\\frac{2}{9}(2 - 3e^x)^{3/2} + C"
    },
    {
      "id": "Задача 1.6",
      "title": "Интеграл с cos√(x-1)",
      "type": "Задача · 1 балл",
      "formalText": "Вычислить: $$\\int \\frac{\\cos\\sqrt{x-1}}{\\sqrt{x-1}}\\, dx$$",
      "keyIdea": "\\(t = \\sqrt{x-1}\\), \\(dt = \\frac{dx}{2\\sqrt{x-1}}\\)",
      "steps": [
        {"title": "Подстановка", "text": "\\(t = \\sqrt{x - 1}\\), \\(\\frac{dx}{\\sqrt{x-1}} = 2\\,dt\\)"},
        {"title": "Вычисление", "text": "$$2\\int \\cos t\\, dt = 2\\sin t + C = 2\\sin\\sqrt{x-1} + C$$"}
      ],
      "formula": "2\\sin\\sqrt{x-1} + C"
    }
  ]
}
