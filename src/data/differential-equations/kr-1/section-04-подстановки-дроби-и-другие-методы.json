    {
      "id": "Задача 5.1",
      "title": "Иррациональная подстановка ∫ √x / (⁴√x³+1) dx",
      "type": "Задача · 2 балла",
      "formalText": "Вычислить: $$\\int \\frac{\\sqrt{x}}{\\sqrt[4]{x^3} + 1}\\, dx$$",
      "keyIdea": "Подстановка \\(t = x^{1/4}\\) (наименьший общий корень — 4-й)",
      "steps": [
        {"title": "Подстановка", "text": "\\(x = t^4\\), \\(dx = 4t^3\\,dt\\), \\(\\sqrt{x} = t^2\\), \\(\\sqrt[4]{x^3} = t^3\\)"},
        {"title": "Приведение", "text": "$$\\int \\frac{t^2 \\cdot 4t^3}{t^3 + 1}\\, dt = 4\\int \\frac{t^5}{t^3 + 1}\\, dt$$\nДелим: \\(t^5 = (t^3 + 1)(t^2) - t^2\\)"},
        {"title": "Разбиение", "text": "$$4\\int t^2\\,dt - 4\\int \\frac{t^2}{t^3 + 1}\\, dt = \\frac{4t^3}{3} - \\frac{4}{3}\\ln|t^3 + 1| + C$$"}
      ],
      "note": "Рационализирующая подстановка: привести все корни к одному."
    },
    {
      "id": "Задача 6.1",
      "title": "Дроби: ∫ dx / ((x+1)(x+2)(x+3))",
      "type": "Задача · 2 балла",
      "formalText": "Вычислить: $$\\int \\frac{dx}{(x+1)(x+2)(x+3)}$$",
      "keyIdea": "Разложение на простейшие дроби: \\(\\frac{A}{x+1} + \\frac{B}{x+2} + \\frac{C}{x+3}\\)",
      "steps": [
        {"title": "Разложение", "text": "$$\\frac{1}{(x+1)(x+2)(x+3)} = \\frac{A}{x+1} + \\frac{B}{x+2} + \\frac{C}{x+3}$$\nПодставляя \\(x = -1, -2, -3\\): \\(A = 1/2\\), \\(B = -1\\), \\(C = 1/2\\)"},
        {"title": "Интегрирование", "text": "$$\\frac{1}{2}\\ln|x+1| - \\ln|x+2| + \\frac{1}{2}\\ln|x+3| + C$$"}
      ],
      "formula": "\\frac{1}{2}\\ln\\frac{|(x+1)(x+3)|}{(x+2)^2} + C"
    },
    {
      "id": "Задача 6.2",
      "title": "Дроби: ∫ x dx / ((x²+1)(x-1)²)",
      "type": "Задача · 2 балла",
      "formalText": "Вычислить: $$\\int \\frac{x\\, dx}{(x^2+1)(x-1)^2}$$",
      "keyIdea": "Разложение: \\(\\frac{Ax+B}{x^2+1} + \\frac{C}{x-1} + \\frac{D}{(x-1)^2}\\)",
      "steps": [
        {"title": "Разложение", "text": "Приравниваем числители и находим коэффициенты.\n\\(x = (Ax+B)(x-1)^2 + C(x^2+1)(x-1) + D(x^2+1)\\)"},
        {"title": "Нахождение коэффициентов", "text": "При \\(x=1\\): \\(1 = 2D\\) → \\(D = 1/2\\).\nПри \\(x=0\\): \\(0 = B - C + D\\).\nСравнивая коэффициенты при старших степенях, находим \\(A, B, C\\)."},
        {"title": "Интегрирование", "text": "Каждый слагаемое — табличный интеграл (\\(\\ln\\), \\(\\text{arctg}\\), степени)."}
      ],
      "note": "Дроби с неприводимым квадратичным множителем дают арктангенс."
    },
    {
      "id": "Задача 6.3",
      "title": "Дроби: ∫ (x³+x+1)/(x(x²+1)) dx",
      "type": "Задача · 2 балла",
      "formalText": "Вычислить: $$\\int \\frac{x^3 + x + 1}{x(x^2+1)}\\, dx$$",
      "keyIdea": "Степень числителя = степень знаменателя → выделить целую часть",
      "steps": [
        {"title": "Деление", "text": "$$\\frac{x^3 + x + 1}{x^3 + x} = 1 + \\frac{1}{x^3 + x} = 1 + \\frac{1}{x(x^2+1)}$$"},
        {"title": "Разложение остатка", "text": "$$\\frac{1}{x(x^2+1)} = \\frac{A}{x} + \\frac{Bx + C}{x^2+1}$$\n\\(A = 1\\), \\(B = -1\\), \\(C = 0\\)"},
        {"title": "Ответ", "text": "$$x + \\ln|x| - \\frac{1}{2}\\ln(x^2+1) + C$$"}
      ],
      "formula": "x + \\ln|x| - \\frac{1}{2}\\ln(x^2+1) + C"
    }
  ]
}
