        {
          "title": "Первое по частям",
          "text": "$u=\\cos x$, $dv=e^x dx$:",
          "math": "$$I=e^x\\cos x+\\int e^x\\sin x\\,dx$$"
        },
        {
          "title": "Второе по частям",
          "text": "$u=\\sin x$, $dv=e^x dx$:",
          "math": "$$I=e^x\\cos x+e^x\\sin x-I$$"
        },
        {
          "title": "Ответ",
          "text": "$2I=e^x(\\cos x+\\sin x)$.",
          "math": "$$\\boxed{\\frac{e^x(\\cos x+\\sin x)}{2}+C}$$"
        }
      ],
      "formula": "\\frac{e^x(\\cos x+\\sin x)}{2}+C"
    },
