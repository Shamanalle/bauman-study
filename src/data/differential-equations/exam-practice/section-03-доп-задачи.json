        },
        {
          "title": "Ответ",
          "math": "$$\\boxed{\\frac{1}{2}\\arctan\\frac{x+2}{2}+C}$$"
        }
      ],
      "formula": "\\frac{1}{2}\\arctan\\frac{x+2}{2}+C"
    },
    {
      "id": "Д1.5",
      "title": "∫ (3x+1)/(x²−x−2) dx",
      "type": "Задача · 6 б. · Рац. дроби",
      "formalText": "**Вычислить:**\n$$\\int\\frac{3x+1}{x^2-x-2}\\,dx$$",
      "tldr": "Разложение: x²−x−2=(x−2)(x+1)",
      "hint": "$\\frac{3x+1}{(x-2)(x+1)}=\\frac{A}{x-2}+\\frac{B}{x+1}$. Найти $A$, $B$",
      "steps": [
        {
          "title": "Разложение",
          "text": "$\\frac{3x+1}{(x-2)(x+1)}=\\frac{A}{x-2}+\\frac{B}{x+1}$.\n\n$x=2$: $7=3A$ → $A=7/3$. $x=-1$: $-2=-3B$ → $B=2/3$."
        },
        {
          "title": "Интегрирование",
          "math": "$$\\frac{7}{3}\\ln|x-2|+\\frac{2}{3}\\ln|x+1|+C$$"
        },
        {
          "title": "Ответ",
          "math": "$$\\boxed{\\frac{7}{3}\\ln|x-2|+\\frac{2}{3}\\ln|x+1|+C}$$"
        }
      ],
      "formula": "\\frac{7}{3}\\ln|x-2|+\\frac{2}{3}\\ln|x+1|+C"
    },
