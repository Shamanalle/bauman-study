        {"title": "Интегрирование", "math": "$$=-\\frac{t^3}{3}+\\frac{t^5}{5}+C$$"},
        {"title": "Ответ", "math": "$$\\boxed{\\frac{\\cos^5 x}{5}-\\frac{\\cos^3 x}{3}+C}$$"}
      ],
      "formula": "\\frac{\\cos^5 x}{5}-\\frac{\\cos^3 x}{3}+C"
    },
