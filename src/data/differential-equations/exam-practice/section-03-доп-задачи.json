      "id": "Д1.1",
      "title": "∫ x³/(x⁴+1) dx",
      "type": "Задача · 6 б. · Подведение",
      "formalText": "**Вычислить:**\n$$\\int\\frac{x^3}{x^4+1}\\,dx$$",
      "tldr": "Подведение: d(x⁴)=4x³dx",
      "hint": "Замена $t=x^4+1$, $dt=4x^3\\,dx$",
      "steps": [
        {"title": "Замена", "text": "$t=x^4+1$, $dt=4x^3 dx$:", "math": "$$\\int\\frac{x^3\\,dx}{x^4+1}=\\frac{1}{4}\\int\\frac{dt}{t}$$"},
        {"title": "Интегрирование", "math": "$$=\\frac{1}{4}\\ln|t|+C$$"},
        {"title": "Ответ", "math": "$$\\boxed{\\frac{1}{4}\\ln(x^4+1)+C}$$"}
      ],
      "formula": "\\frac{1}{4}\\ln(x^4+1)+C"
    },
    {
      "id": "Д1.2",
      "title": "∫ x·arctg x dx",
      "type": "Задача · 6 б. · По частям",
      "formalText": "**Вычислить:**\n$$\\int x\\arctan x\\,dx$$",
      "tldr": "По частям: u=arctg x, dv=x dx",
      "hint": "$u=\\arctan x$, $dv=x\\,dx$ → $du=\\frac{dx}{1+x^2}$, $v=\\frac{x^2}{2}$",
      "steps": [
        {"title": "По частям", "text": "$u=\\arctan x$, $dv=x\\,dx$:\n$v=x^2/2$, $du=dx/(1+x^2)$.", "math": "$$\\frac{x^2}{2}\\arctan x-\\frac{1}{2}\\int\\frac{x^2}{1+x^2}dx$$"},
        {"title": "Упрощение", "text": "$\\frac{x^2}{1+x^2}=1-\\frac{1}{1+x^2}$.", "math": "$$=\\frac{x^2}{2}\\arctan x-\\frac{1}{2}(x-\\arctan x)+C$$"},
        {"title": "Ответ", "math": "$$\\boxed{\\frac{x^2+1}{2}\\arctan x-\\frac{x}{2}+C}$$"}
      ],
      "formula": "\\frac{x^2+1}{2}\\arctan x-\\frac{x}{2}+C"
    },
