      "formalText": "**Вычислить:**\n$$\\int\\frac{dx}{x\\sqrt{x^2+1}}$$",
      "tldr": "Замена t=1/x → −∫dt/√(1+t²)",
      "hint": "Замена $t=1/x$, $dx=-dt/t^2$ → $-\\int\\frac{dt}{\\sqrt{1+t^2}}$",
      "steps": [
        {"title": "Замена t=1/x", "text": "$x=1/t$, $dx=-dt/t^2$, $\\sqrt{x^2+1}=\\sqrt{1/t^2+1}=\\sqrt{1+t^2}/|t|$.", "math": "$$-\\int\\frac{t\\,dt}{t^2\\cdot\\sqrt{1+t^2}/t}=-\\int\\frac{dt}{\\sqrt{1+t^2}}$$"},
        {"title": "Табличный интеграл", "math": "$$=-\\ln|t+\\sqrt{1+t^2}|+C$$"},
        {"title": "Ответ", "text": "Обратная замена $t=1/x$:", "math": "$$\\boxed{-\\ln\\left|\\frac{1}{x}+\\sqrt{1+\\frac{1}{x^2}}\\right|+C}$$"}
      ],
      "formula": "\\ln\\left|\\frac{x}{1+\\sqrt{1+x^2}}\\right|+C"
    },
