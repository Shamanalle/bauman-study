      "steps": [
        {
          "title": "Разложение",
          "text": "$\\sin^3 x\\cos^2 x=(1-\\cos^2 x)\\cos^2 x\\sin x$. Замена $t=\\cos x$, $dt=-\\sin x\\,dx$:",
          "math": "$$-\\int(1-t^2)t^2\\,dt=-\\int(t^2-t^4)dt$$"
        },
        {
          "title": "Интегрирование",
          "math": "$$=-\\frac{t^3}{3}+\\frac{t^5}{5}+C$$"
        },
        {
          "title": "Ответ",
          "math": "$$\\boxed{\\frac{\\cos^5 x}{5}-\\frac{\\cos^3 x}{3}+C}$$"
        }
      ],
      "formula": "\\frac{\\cos^5 x}{5}-\\frac{\\cos^3 x}{3}+C"
    },
