      "hint": "$x^2+4x+8=(x+2)^2+4$ → табличный $\\int\\frac{dt}{t^2+a^2}$",
      "steps": [
        {"title": "Полный квадрат", "text": "$x^2+4x+8=(x+2)^2+4$. Замена $t=x+2$:", "math": "$$\\int\\frac{dt}{t^2+4}=\\frac{1}{2}\\arctan\\frac{t}{2}+C$$"},
        {"title": "Ответ", "math": "$$\\boxed{\\frac{1}{2}\\arctan\\frac{x+2}{2}+C}$$"}
      ],
      "formula": "\\frac{1}{2}\\arctan\\frac{x+2}{2}+C"
    },
    {
      "id": "Д1.5",
      "title": "∫ (3x+1)/(x²−x−2) dx",
      "type": "Задача · 6 б. · Рац. дроби",
      "formalText": "**Вычислить:**\n$$\\int\\frac{3x+1}{x^2-x-2}\\,dx$$",
      "tldr": "Разложение: x²−x−2=(x−2)(x+1)",
      "hint": "$\\frac{3x+1}{(x-2)(x+1)}=\\frac{A}{x-2}+\\frac{B}{x+1}$. Найти $A$, $B$",
      "steps": [
        {"title": "Разложение", "text": "$\\frac{3x+1}{(x-2)(x+1)}=\\frac{A}{x-2}+\\frac{B}{x+1}$.\n\n$x=2$: $7=3A$ → $A=7/3$. $x=-1$: $-2=-3B$ → $B=2/3$."},
        {"title": "Интегрирование", "math": "$$\\frac{7}{3}\\ln|x-2|+\\frac{2}{3}\\ln|x+1|+C$$"},
        {"title": "Ответ", "math": "$$\\boxed{\\frac{7}{3}\\ln|x-2|+\\frac{2}{3}\\ln|x+1|+C}$$"}
      ],
      "formula": "\\frac{7}{3}\\ln|x-2|+\\frac{2}{3}\\ln|x+1|+C"
    },
