        },
        {
          "title": "Ответ",
          "math": "$$\\boxed{-x^2\\cos x + 2x\\sin x + 2\\cos x + C}$$"
        }
      ],
      "formula": "-x^2\\cos x + 2x\\sin x + 2\\cos x + C"
    },
