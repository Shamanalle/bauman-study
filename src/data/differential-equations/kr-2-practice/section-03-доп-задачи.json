        {
          "title": "Линейное для z",
          "text": "$\\mu = e^{-\\int dx/x} = 1/x$. $(z/x)' = -1/x$.\n\n$z/x = -\\ln|x| + C$."
        },
        {
          "title": "Ответ",
          "text": "$z = x(C - \\ln|x|)$. $y = 1/z$:",
          "math": "$$\\boxed{y = \\frac{1}{x(C - \\ln|x|)}}$$"
        }
