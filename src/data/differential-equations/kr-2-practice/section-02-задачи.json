      "type": "Задача · 3 балла · Разделяющиеся",
      "formalText": "**Классифицировать и найти общий интеграл:**\n$$\\frac{dx}{x(y-1)} + \\frac{dy}{y(x+2)} = 0$$",
      "tldr": "Разделяющиеся переменные: собираем x к dx, y к dy",
      "steps": [
        {
          "title": "Домножаем на xy(y-1)(x+2)",
          "math": "$$y(x+2)\\,dx + x(y-1)\\,dy = 0$$"
        },
        {
          "title": "Делим на xy",
          "math": "$$\\frac{x+2}{x}\\,dx + \\frac{y-1}{y}\\,dy = 0$$"
        },
        {
          "title": "Раскрываем дроби",
          "math": "$$\\left(1 + \\frac{2}{x}\\right)dx + \\left(1 - \\frac{1}{y}\\right)dy = 0$$"
        },
        {
          "title": "Интегрируем",
          "math": "$$\\boxed{x + 2\\ln|x| + y - \\ln|y| = C}$$"
        }
      ],
      "formula": "x + 2\\ln|x| + y - \\ln|y| = C",
      "hint": "Домножаем на xy(y-1)(x+2): $y(x+2)\\,dx + x(y-1)\\,dy = 0$"
    },
