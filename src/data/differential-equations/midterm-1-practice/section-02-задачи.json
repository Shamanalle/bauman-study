        {
          "title": "Определяем пределы",
          "text": "При $t = 1$: $x = a$, $y = 0$ (точка на оси Ox).\nПри $t \\to 0^+$: $x \\to 0$, $y \\to -\\infty$.\n\nКривая выходит из начала координат ($x=0$) при $t \\to 0^+$ и доходит до $(a, 0)$ при $t = 1$. Область ограничена кривой, осями и вращается вокруг $Ox$. Пределы по $t$: от $0$ до $1$."
        },
        {
          "title": "Формула (метод дисков)",
          "text": "$x'(t) = 2at$. Подставляем в формулу объёма:",
          "math": "$$V = \\pi\\int_0^1 y^2(t)\\,x'(t)\\,dt = \\pi\\int_0^1 (a\\ln t)^2 \\cdot 2at\\,dt = 2\\pi a^3\\int_0^1 t\\ln^2 t\\,dt$$"
        },
        {
          "title": "Интегрирование по частям (1-е)",
          "text": "$u = \\ln^2 t$, $dv = t\\,dt$ → $du = \\frac{2\\ln t}{t}dt$, $v = \\frac{t^2}{2}$.",
          "math": "$$\\int_0^1 t\\ln^2 t\\,dt = \\frac{t^2}{2}\\ln^2 t\\Big|_0^1 - \\int_0^1 t\\ln t\\,dt = 0 - \\int_0^1 t\\ln t\\,dt$$"
        },
        {
          "title": "Интегрирование по частям (2-е)",
          "text": "$u = \\ln t$, $dv = t\\,dt$ → $du = \\frac{dt}{t}$, $v = \\frac{t^2}{2}$.",
          "math": "$$\\int_0^1 t\\ln t\\,dt = \\frac{t^2}{2}\\ln t\\Big|_0^1 - \\int_0^1\\frac{t}{2}dt = 0 - \\frac{1}{4} = -\\frac{1}{4}$$"
        },
        {
          "title": "Ответ",
          "text": "$\\int_0^1 t\\ln^2 t\\,dt = -(-\\frac{1}{4}) = \\frac{1}{4}$.",
          "math": "$$V = 2\\pi a^3 \\cdot \\frac{1}{4} = \\frac{\\pi a^3}{2}$$"
        }
