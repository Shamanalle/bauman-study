      "title": "Разд. переменные: общий интеграл",
      "type": "Задача · 3 балла · Разделяющиеся",
      "formalText": "**Классифицировать и найти общий интеграл:**\n$$\\frac{dx}{x(y-1)} + \\frac{dy}{y(x+2)} = 0$$",
      "tldr": "Разделяющиеся переменные: собираем x к dx, y к dy",
      "steps": [
        {
          "title": "Домножаем на xy(y-1)(x+2)",
          "math": "$$y(x+2)\\,dx + x(y-1)\\,dy = 0$$"
        },
        {
          "title": "Делим на xy",
          "math": "$$\\frac{x+2}{x}\\,dx + \\frac{y-1}{y}\\,dy = 0$$"
        },
        {
          "title": "Раскрываем дроби",
          "math": "$$\\left(1 + \\frac{2}{x}\\right)dx + \\left(1 - \\frac{1}{y}\\right)dy = 0$$"
        },
        {
          "title": "Интегрируем",
          "math": "$$x + 2\\ln|x| + y - \\ln|y| = C$$"
        }
      ],
      "formula": "x + 2\\ln|x| + y - \\ln|y| = C",
      "hint": "Домножаем на xy(y-1)(x+2): $y(x+2)\\,dx + x(y-1)\\,dy = 0$"
    },
    {
      "id": "2",
      "title": "Разд. переменные + задача Коши",
      "type": "Задача · 3 балла · Разделяющиеся",
      "formalText": "**Классифицировать и решить задачу Коши:**\n$$(1+x)y\\,dx + (1-y)x\\,dy = 0, \\quad y(1) = e$$",
      "tldr": "Делим на xy → разделяющиеся переменные",
      "steps": [
        {
          "title": "Разделяем переменные",
          "text": "Делим на $xy$:",
          "math": "$$\\left(\\frac{1}{x} + 1\\right)dx + \\left(\\frac{1}{y} - 1\\right)dy = 0$$"
        },
        {
          "title": "Интегрируем",
          "math": "$$\\ln|x| + x + \\ln|y| - y = C \\quad \\Rightarrow \\quad \\ln|xy| + x - y = C$$"
        },
        {
          "title": "Задача Коши: y(1) = e",
          "math": "$$\\ln|e| + 1 - e = C \\quad \\Rightarrow \\quad C = 2 - e$$"
        },
        {
          "title": "Ответ",
          "math": "$$\\ln|xy| + x - y = 2 - e$$"
        }
      ],
      "formula": "\\ln|xy| + x - y = 2 - e",
      "hint": "Разделяем переменные: $xy$"
    },
